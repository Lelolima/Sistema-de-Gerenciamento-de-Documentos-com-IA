# Backend — copie para .env. Nunca commite valores reais.

# CORS (lista separada por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Armazenamento local (usado quando SUPABASE_URL/SUPABASE_KEY estão vazios)
STORAGE_DIR=uploads

# Supabase Storage (opcional) — bucket "documents"
SUPABASE_URL=
SUPABASE_KEY=

# Ainda NÃO lidas pelo código (reservadas para evolução):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docmanager
# SECRET_KEY=gere-um-valor-aleatorio
# MAX_FILE_SIZE=52428800
